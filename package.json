{
  "name": "stoner4therecord",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @stoner4therecord/api",
    "dev:web": "npm run dev -w @stoner4therecord/web",
    "build": "npm run build -w @stoner4therecord/web",
    "db:migrate": "npm run db:migrate -w @stoner4therecord/api",
    "db:seed": "npm run db:seed -w @stoner4therecord/api",
    "typecheck": "npm run typecheck -w @stoner4therecord/api && npm run typecheck -w @stoner4therecord/web"
  }
}
